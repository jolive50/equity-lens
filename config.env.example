# StockSense AI Analysis System Environment Variables

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Alpha Vantage Financial Data API  
# Get your API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Financial News & Data APIs
FINNHUB_API_KEY=your_finnhub_api_key_here

# Yahoo Finance Configuration (usually no key needed)
YAHOO_FINANCE_ENABLED=true

# Rate Limiting Configuration
API_REQUEST_DELAY_MS=500
MAX_REQUESTS_PER_MINUTE=12

# Sentiment Analysis Configuration
FINBERT_MODEL_PATH=./models/finbert
MAX_NEWS_ARTICLES=25

# System Configuration
FEATURE_HISTORICAL_ANALYSIS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_FAST_MODE=true

# Confidence Threshold Configuration
DEFAULT_CONFIDENCE_THRESHOLD=0.95
MIN_RECOMMENDATION_CONFIDENCE=0.95

# Backend Service URLs
EXPEDITE_BACKEND_URL=http://localhost:8000
PYTHON_AI_SERVICE_URL=http://localhost:8001

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGS=false

# Data Persistence
DATA_CACHE_TTL_SECONDS=300
CLEANUP_INTERVAL_MINUTES=60
