# ========================================
# StockSense Environment Configuration Template
# ========================================
# Copy this file to .env and fill in your actual API keys
# Command: cp .env.example .env

# ---------------------------
# Financial Data API Keys
# ---------------------------
# Alpha Vantage: Get your free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Tiingo: Get your free key at https://www.tiingo.com/
TIINGO_API_KEY=your_tiingo_key_here

# Finnhub: Get your free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# NewsAPI: Get your free key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ---------------------------
# AI/LLM API Keys
# ---------------------------
# OpenAI: Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# LangChain: Get your key at https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langchain_key_here

# ---------------------------
# Database Configuration
# ---------------------------
DATABASE_URL=postgresql://user:pass@localhost/stocksense

# ---------------------------
# Application Settings
# ---------------------------
APP_DATA_DIR=./data/realtime/feature_store
ENVIRONMENT=development
DEBUG=True
